{
  "family": "fragments-task",
  "taskRoleArn": "arn:aws:iam::148981339957:role/LabRole",
  "executionRoleArn": "arn:aws:iam::148981339957:role/LabRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "fragments-container",
      "image": "REPLACE_WITH_YOUR_ECR_IMAGE_URI",
      "cpu": 0,
      "portMappings": [
        {
          "name": "fragments-container-80-tcp",
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "AWS_COGNITO_POOL_ID",
          "value": "us-east-2_gfnJQiq2T"
        },
        {
          "name": "FRAGMENTS_LOG_LEVEL",
          "value": "debug"
        },
        {
          "name": "API_URL",
          "value": "http://localhost"
        },
        {
          "name": "PORT",
          "value": "80"
        },
        {
          "name": "AWS_COGNITO_CLIENT_ID",
          "value": "209s8g2dsdnospjo76uuh2uvv5"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/fragments-task",
          "awslogs-create-group": "true",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "systemControls": []
    }
  ],
  "volumes": [],
  "placementConstraints": [],
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "tags": []
}